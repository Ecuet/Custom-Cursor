{
	"geode": "5.6.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "ecuet.custom-cursor",
	"name": "Custom Cursor",
	"version": "v1.0.2",
	"developer": "ecuet",
	"description": "Allows you to customize your cursor yourself",
	"dependencies": {
		"alphalaneous.alphas_geode_utils": ">=1.1.8",
		"geode.node-ids": ">=v1.20.0"
	},
	"resources": {
		"sprites": [
            "resources/*.png"
        ]
	},
	"tags": [
		"universal","interface","enhancement"
	],
	"settings": {
		"Presets":{
			"type":"string",
			"name": "Preset",
			"description": "hey, i added presets in case you dont want to make your cursor yourself <3",
			"default": "Custom",
			"one-of": ["Custom", "Pixel","Gothic","Calamitas","Stone","Omori1","Omori2","Pink"]
		},

		"CursorScale": {
			"type": "float",
			"name": "Cursor Scale",
			"description": "size doesnt matter",
			"default": 1,
			"min": 0.5,
			"max": 1.5,
			"control": {
				"arrows": true,
				"arrow-step": 0.05,
				"big-arrows": false,
				"big-arrow-step": 0,
				"slider": true,
				"slider-step": 0.05,
				"input": true
			}
		},
		"DisableHoveredCursor":{
			"type": "bool",
			"name": "Disabled Hovered Cursor",
			"description": "Since it works a bit weird, you can turn it off",
			"default": false
		},

		"DefaultCursor":{
			"type": "file",
			"description": "When nothing happens, it ll be for you, if nothing selected custom cursor wont work",
			"name": "Default Cursor",
			"default":{
				"win": "",
				"android": "",
				"mac": ""
			},
			"control": {
				"dialog": "open",
				"filters": [
					{
						"files": ["*.png","*.jpg","*.jpeg"],
						"description": "Pictures"
					}
				]
			}
		},
		"HoveredCursor":{
			"type": "file",
			"name": "Hovered Cursor",
			"description": "Cursor when you hover on button",
			"default":{
				"win": "",
				"android": "",
				"mac": ""
			},
			"control": {
				"dialog": "open",
				"filters": [
					{
						"files": ["*.png","*.jpg","*.jpeg"],
						"description": "Pictures"
					}
				]
			}
		},
		"HoldCursor":{
			"type": "file",
			"name": "Hold Cursor",
			"description": "Cursor when you hold Left Mouse Button",
			"default":{
				"win": "",
				"android": "",
				"mac": ""
			},
			"control": {
				"dialog": "open",
				"filters": [
					{
						"files": ["*.png","*.jpg","*.jpeg"],
						"description": "Pictures"
					}
				]
			}
		}
	}
}
